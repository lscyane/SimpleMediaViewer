#pragma code_page(65001)

#include <windows.h>
#define IDI_APP_ICON 101
IDI_APP_ICON ICON "app.ico"

#include "src/resource.h"

1 VERSIONINFO
   FILEVERSION 0,0,0,0
 PRODUCTVERSION 0,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName", "TeaSoundProject (TSP)\0"
			VALUE "FileDescription", "SimpleMediaViewer\0"
			VALUE "FileVersion", "0.0.0.0\0"
			VALUE "InternalName", "SimpleMediaViewer\0"
			VALUE "LegalCopyright", "(C) 2026 lscyane\0"
			VALUE "OriginalFilename", "SimpleMediaViewer.exe\0"
			VALUE "ProductName", "SimpleMediaViewer\0"
			VALUE "ProductVersion", "0.0.0.0\0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END

IDD_FILTER_DIALOG DIALOGEX 0, 0, 300, 242
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "フィルター"
FONT 9, "Segoe UI"
BEGIN
	LTEXT "表示する拡張子を選択してください。", -1, 8, 8, 284, 12
	PUSHBUTTON "すべてチェック", IDC_FILTER_SELECT_ALL, 8, 24, 90, 16
	PUSHBUTTON "すべてチェックを外す", IDC_FILTER_CLEAR_ALL, 104, 24, 120, 16
	DEFPUSHBUTTON "OK", IDOK, 184, 218, 48, 16
	PUSHBUTTON "キャンセル", IDCANCEL, 236, 218, 56, 16
END

IDD_SLIDESHOW_DIALOG DIALOGEX 0, 0, 224, 76
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "スライドショー"
FONT 9, "Segoe UI"
BEGIN
	LTEXT "切替間隔（秒）:", -1, 8, 14, 72, 12
	EDITTEXT IDC_SLIDESHOW_INTERVAL, 82, 12, 72, 14, ES_AUTOHSCROLL | WS_TABSTOP
	CONTROL "", IDC_SLIDESHOW_SPIN, "msctls_updown32", UDS_ARROWKEYS | UDS_NOTHOUSANDS, 158, 12, 12, 14
	DEFPUSHBUTTON "OK", IDOK, 112, 52, 48, 16
	PUSHBUTTON "キャンセル", IDCANCEL, 164, 52, 52, 16
END
