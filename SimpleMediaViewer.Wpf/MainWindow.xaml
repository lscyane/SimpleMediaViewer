<Window x:Class="SimpleMediaViewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleMediaViewer.Wpf"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- 表示モード切替用 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="4">
            <Button Content="ウィンドウいっぱい" Click="Fit_Click" Margin="0,0,8,0"/>
            <Button Content="等倍表示" Click="Original_Click"/>
            <Button Content="再生" Click="Play_Click" Margin="0,0,8,0"/>
            <Button Content="停止" Click="Stop_Click"/>
        </StackPanel>

        <!-- 画像表示本体 -->
        <Grid x:Name="hostgrid" Grid.Row="1">
            <!-- 動画表示 -->
            <Viewbox Grid.Row="1" x:Name="VideoViewbox" Stretch="None" Visibility="Collapsed">
                <vlc:VideoView x:Name="VideoView" Width="{Binding ElementName=hostgrid, Path=ActualWidth}" Height="{Binding ElementName=hostgrid, Path=ActualHeight}"/>
            </Viewbox>

            <!-- 静止画/WebPアニメーション表示 -->
            <Viewbox x:Name="ImageViewbox" Stretch="Uniform">
                <Image x:Name="ImageView" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
