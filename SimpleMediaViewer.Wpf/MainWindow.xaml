<Window x:Class="SimpleMediaViewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:SimpleMediaViewer.Wpf"
        xmlns:vm="clr-namespace:SimpleMediaViewer.Wpf"
        Left="{Binding WindowLeft, Mode=TwoWay}" Top="{Binding WindowTop, Mode=TwoWay}" Width="{Binding WindowWidth, Mode=TwoWay}" Height="{Binding WindowHeight, Mode=TwoWay}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        Title="MainWindow"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}">
    <Grid x:Name="hostgrid" Background="Black">
        
        <!-- コンテキストメニュー -->
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="リスト">
                    <MenuItem Header="前のファイル" Command="{Binding PreviousFileCommand}" InputGestureText="Left"/>
                    <MenuItem Header="次のファイル" Command="{Binding NextFileCommand}" InputGestureText="Right"/>
                    <Separator/>
                    <MenuItem Header="ファイルリストを表示" Command="{Binding ShowListDialogCommand}"/>
                    <Separator/>
                    <MenuItem Header="並び順">
                        <MenuItem Header="名前 (昇順)" Command="{Binding SetSortOrderCommand}" CommandParameter="0"/>
                        <MenuItem Header="名前 (降順)" Command="{Binding SetSortOrderCommand}" CommandParameter="1"/>
                        <Separator/>
                        <MenuItem Header="更新日時 (昇順)" Command="{Binding SetSortOrderCommand}" CommandParameter="2"/>
                        <MenuItem Header="更新日時 (降順)" Command="{Binding SetSortOrderCommand}" CommandParameter="3"/>
                        <Separator/>
                        <MenuItem Header="ファイルサイズ (昇順)" Command="{Binding SetSortOrderCommand}" CommandParameter="4"/>
                        <MenuItem Header="ファイルサイズ (降順)" Command="{Binding SetSortOrderCommand}" CommandParameter="5"/>
                        <Separator/>
                        <MenuItem Header="ランダム" Command="{Binding SetSortOrderCommand}" CommandParameter="6"/>
                    </MenuItem>
                </MenuItem>
                <Separator/>
                <MenuItem Header="表示">
                    <MenuItem Header="ウィンドウいっぱい" Command="{Binding FitCommand}"/>
                    <MenuItem Header="等倍表示" Command="{Binding OriginalCommand}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="操作">
                    <MenuItem Header="再生/一時停止" Command="{Binding PlayPauseCommand}" InputGestureText="Space"/>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- 動画表示 -->
        <Viewbox x:Name="VideoViewbox" 
                 Stretch="{Binding VideoStretch}" 
                 Visibility="{Binding VideoViewVisibility}">
            <vlc:VideoView x:Name="VideoView" 
                           Width="{Binding ElementName=hostgrid, Path=ActualWidth}" 
                           Height="{Binding ElementName=hostgrid, Path=ActualHeight}"/>
        </Viewbox>

        <!-- 静止画/WebPアニメーション表示 -->
        <Viewbox x:Name="ImageViewbox" 
                 Stretch="{Binding ImageStretch}" 
                 Visibility="{Binding ImageViewVisibility}"
                 Opacity="1"
                 x:FieldModifier="private">
            <Image x:Name="ImageView" 
                   Source="{Binding ImageSource}" 
                   Stretch="None" 
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Viewbox>
    </Grid>
</Window>
