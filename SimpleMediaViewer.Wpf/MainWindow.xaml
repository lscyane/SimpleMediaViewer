<Window x:Class="SimpleMediaViewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleMediaViewer.Wpf"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        Left="{Binding WindowLeft, Mode=TwoWay}" Top="{Binding WindowTop, Mode=TwoWay}" Width="{Binding WindowWidth, Mode=TwoWay}" Height="{Binding WindowHeight, Mode=TwoWay}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        Title="MainWindow">
    <Grid x:Name="hostgrid">
        
        <!-- コンテキストメニュー -->
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="ウィンドウいっぱい" Command="{Binding FitCommand}"/>
                <MenuItem Header="等倍表示" Command="{Binding OriginalCommand}"/>
                <Separator/>
                <MenuItem Header="再生/一時停止" Command="{Binding PlayPauseCommand}" InputGestureText="Space"/>
                <Separator/>
                <MenuItem Header="次のファイル" Command="{Binding NextFileCommand}" InputGestureText="→"/>
                <MenuItem Header="前のファイル" Command="{Binding PreviousFileCommand}" InputGestureText="←"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- 動画表示 -->
        <Viewbox x:Name="VideoViewbox" 
                 Stretch="{Binding VideoStretch}" 
                 Visibility="{Binding VideoViewVisibility}">
            <vlc:VideoView x:Name="VideoView" 
                           Width="{Binding ElementName=hostgrid, Path=ActualWidth}" 
                           Height="{Binding ElementName=hostgrid, Path=ActualHeight}"/>
        </Viewbox>

        <!-- 静止画/WebPアニメーション表示 -->
        <Viewbox x:Name="ImageViewbox" 
                 Stretch="{Binding ImageStretch}" 
                 Visibility="{Binding ImageViewVisibility}">
            <Image x:Name="ImageView" 
                   Source="{Binding ImageSource}" 
                   Stretch="None" 
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Viewbox>
    </Grid>
</Window>
