<Window x:Class="SimpleMediaViewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleMediaViewer.Wpf"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        mc:Ignorable="d"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="4">
            <Button Content="ウィンドウいっぱい" Command="{Binding FitCommand}" Margin="0,0,8,0"/>
            <Button Content="等倍表示" Command="{Binding OriginalCommand}"/>
            <Button Content="再生" Command="{Binding PlayCommand}" Margin="8,0,8,0"/>
            <Button Content="停止" Command="{Binding StopCommand}"/>
        </StackPanel>

        <Grid x:Name="hostgrid" Grid.Row="1">
            <!-- 動画表示 -->
            <Viewbox Grid.Row="1" x:Name="VideoViewbox" 
                     Stretch="{Binding VideoStretch}" 
                     Visibility="{Binding VideoViewVisibility}">
                <vlc:VideoView x:Name="VideoView" 
                               Width="{Binding ElementName=hostgrid, Path=ActualWidth}" 
                               Height="{Binding ElementName=hostgrid, Path=ActualHeight}"/>
            </Viewbox>

            <!-- 静止画/WebPアニメーション表示 -->
            <Viewbox x:Name="ImageViewbox" 
                     Stretch="{Binding ImageStretch}" 
                     Visibility="{Binding ImageViewVisibility}">
                <Image x:Name="ImageView" 
                       Source="{Binding ImageSource}" 
                       Stretch="None" 
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
