<Window x:Class="SimpleMediaViewer.Wpf.Dialog.FileListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:bh="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lw="http://cyane.info/wpf"
        xmlns:local="clr-namespace:SimpleMediaViewer.Wpf"
        xmlns:vm="clr-namespace:SimpleMediaViewer.Wpf"
        Title="{Binding Title}" 
        Left="{Binding WindowLeft, Mode=TwoWay}" Top="{Binding WindowTop, Mode=TwoWay}" Width="{Binding WindowWidth, Mode=TwoWay}" Height="{Binding WindowHeight, Mode=TwoWay}"
        AllowDrop="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:FileListDialogViewModel}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="1" Grid.ColumnSpan="3">
            <!-- FileList -->
            <ListView Grid.Column="1" 
                      ItemsSource="{Binding FileManager.CurrentFileList}"
                      SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ファイル名" DisplayMemberBinding="{Binding}" Width="400"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- ボタン類 -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="60" Margin="4" DockPanel.Dock="Right" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True"/>
            <Button MinWidth="60" Margin="4" DockPanel.Dock="Right" Command="{Binding OkCommand}" Content="OK"/>
        </StackPanel>
    </Grid>
</Window>
